# AI Service Environment Variables Example
# Скопіюйте цей файл на .env у папці AI/rag-chatbot

# ==================== СЕРВЕР ====================
PORT=8001

# ==================== GOOGLE API ====================
# Отримайте API ключ на https://ai.google.dev/
GOOGLE_API_KEY=your-google-api-key-here

# ==================== CORS ====================
# Дозволити запити з цих джерел (повинна збігатися з Backend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001,https://alexsite-swzo.onrender.com

# ==================== AI МОДЕЛЬ ====================
# Можна змінити на інші моделі Google
# Доступні: gemini-3.1-flash-lite, gemini-3.1-flash, gemini-pro
# AI_MODEL=gemini-3.1-flash-lite
