# LLM API Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic, cohere
LLM_API_KEY=sk-your-api-key-here  # Get from your provider
LLM_MODEL_NAME=gpt-3.5-turbo  # OpenAI: gpt-3.5-turbo, gpt-4; Anthropic: claude-3-sonnet, claude-3-opus; Cohere: command

# Embedding Model (Local)
EMBEDDING_MODEL_NAME=sentence-transformers/distilbert-base-uncased

# Model Parameters
DEVICE=cpu  # Device for embeddings (cpu or cuda)
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9

# Vector Database Configuration
VECTOR_DB_TYPE=chroma
CHROMA_PATH=./vector_store

# FastAPI Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Environment
ENVIRONMENT=development

# Document Processing
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Dataset Path
DATASET_PATH=./datasets
